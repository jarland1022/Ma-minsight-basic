# Copy to .env and adjust for your ECS deployment

DATABASE_URL=postgresql+asyncpg://ma_minsight:CHANGE_ME@localhost:5432/ma_minsight
SYNC_DATABASE_URL=postgresql://ma_minsight:CHANGE_ME@localhost:5432/ma_minsight
DB_ECHO=false

REDIS_URL=redis://localhost:6379/0
API_KEY=change-me-in-production

# Wazuh Indexer credentials (referenced by data_sources.config *_env keys)
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=CHANGE_ME

INGESTION_MAX_BATCHES_PER_RUN=10

# Event aggregation (methodology option B)
EVENT_AGGREGATION_WINDOW_HOURS=24

# Triage thresholds (phase 3)
TRIAGE_DEEP_REVIEW_THRESHOLD=70

# LLM (phase 5)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Embeddings (phase 7, OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Threat intel sync (AbuseIPDB / GreyNoise → threat_intel_entries)
ABUSEIPDB_API_KEY=
ABUSEIPDB_MAX_AGE_DAYS=90
GREYNOISE_API_KEY=
THREAT_INTEL_SYNC_WINDOW_DAYS=7
THREAT_INTEL_SYNC_LIMIT=200
THREAT_INTEL_CACHE_TTL_HOURS=24
THREAT_INTEL_SKIP_PRIVATE_IPS=true

# GeoIP (MaxMind GeoLite2-City.mmdb)
# Container path (inside app):
GEOLITE2_CITY_PATH=/data/geoip/GeoLite2-City.mmdb
# Host path (project dir or absolute path on ECS):
GEOLITE2_HOST_PATH=./data/geoip/GeoLite2-City.mmdb

# Console auth (phase 8)
JWT_SECRET=change-me-jwt-secret-use-32-chars-min
JWT_EXPIRE_HOURS=8
ADMIN_INITIAL_PASSWORD=changeme

# WeCom (phase 6)
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_WEBHOOK_URL=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
