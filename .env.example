# Copy to .env and adjust for your ECS deployment

DATABASE_URL=postgresql+asyncpg://ma_minsight:CHANGE_ME@localhost:5432/ma_minsight
SYNC_DATABASE_URL=postgresql://ma_minsight:CHANGE_ME@localhost:5432/ma_minsight
DB_ECHO=false

REDIS_URL=redis://localhost:6379/0
API_KEY=change-me-in-production

# Wazuh Indexer credentials (referenced by data_sources.config *_env keys)
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=CHANGE_ME

INGESTION_MAX_BATCHES_PER_RUN=10

# Event aggregation (methodology option B)
EVENT_AGGREGATION_WINDOW_HOURS=24

# Triage thresholds (phase 3)
TRIAGE_DEEP_REVIEW_THRESHOLD=70

# LLM (phase 5) — outbound via EgressGateway (P0-06). BYO endpoint ≠ local-only processing.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Embeddings (phase 7, OpenAI-compatible API) — default privacy.embed_egress_enabled=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# P0-06 privacy / egress (backend-enforced; frontend cannot override)
# Full reference: docs/deploy/privacy-config.md
# Priority: PRIVACY_* env > strict_mode > system_config > code defaults.
# Pseudonymization is NOT anonymization. Do not commit real secrets.
APP_ENV=development
PRIVACY_PSEUDONYM_SECRET=
PRIVACY_STRICT_MODE=false
PRIVACY_LLM_EGRESS_ENABLED=true
PRIVACY_TI_EGRESS_ENABLED=true
PRIVACY_WECOM_EGRESS_ENABLED=true
PRIVACY_EMBED_EGRESS_ENABLED=false
PRIVACY_WEBHOOK_EGRESS_ENABLED=true
PRIVACY_LLM_ALLOW_PUBLIC_IP_PLAINTEXT=false
PRIVACY_LLM_ALLOW_USERNAME_PLAINTEXT=false
PRIVACY_LLM_ALLOW_HOSTNAME_PLAINTEXT=false
PRIVACY_LLM_ALLOW_FULL_URL=false
PRIVACY_WECOM_ALLOW_HOST_USER=false
# PRIVACY_ALLOWED_LLM_BASE_URLS=
# PRIVACY_CUSTOMER_SCOPE_ID=

# Threat intel sync (AbuseIPDB / GreyNoise → threat_intel_entries)
ABUSEIPDB_API_KEY=
ABUSEIPDB_MAX_AGE_DAYS=90
GREYNOISE_API_KEY=
THREAT_INTEL_SYNC_WINDOW_DAYS=7
THREAT_INTEL_SYNC_LIMIT=200
THREAT_INTEL_CACHE_TTL_HOURS=24
THREAT_INTEL_SKIP_PRIVATE_IPS=true

# GeoIP (MaxMind GeoLite2-City.mmdb)
# Container path (inside app):
GEOLITE2_CITY_PATH=/data/geoip/GeoLite2-City.mmdb
# Host path (project dir or absolute path on ECS):
GEOLITE2_HOST_PATH=./data/geoip/GeoLite2-City.mmdb

# Console auth (P0-01)
# Production (APP_ENV=production) refuses weak JWT_SECRET / API_KEY / ADMIN_INITIAL_PASSWORD.
# Dev may set ALLOW_INSECURE_DEFAULTS=true; that flag is rejected in production.
APP_ENV=development
ALLOW_INSECURE_DEFAULTS=false
JWT_SECRET=dev-only-replace-with-long-random-secret-32chars
JWT_EXPIRE_HOURS=8
ADMIN_INITIAL_PASSWORD=replace-with-strong-password
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
BOOTSTRAP_TOKEN_TTL_MINUTES=30

# P0-02 Legacy env API_KEY compatibility (D-KEY-02/04)
# Set false after migrating automation to scoped keys (see docs/API_KEY_MIGRATION.md).
# Disabling never restores high-risk privileges on the legacy key.
API_KEY=replace-with-strong-api-key
LEGACY_API_KEY_ENABLED=true

# WeCom (phase 6)
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_WEBHOOK_URL=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
