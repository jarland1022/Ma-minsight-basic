# MA-MinSight nginx example (same-origin: static + API)
# Production Docker uses deploy/nginx/ma-minsight.conf — this file is for bare-metal reference.

server {
    listen 80;
    server_name ma-minsight.example.com;

    root /var/www/ma-minsight/web/dist;
    index index.html;

    location = /health {
        proxy_pass http://127.0.0.1:8000/health;
    }

    location = /health/ready {
        proxy_pass http://127.0.0.1:8000/health/ready;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
