# Production environment template for docker compose
# Copy: cp deploy/env/production.env.example .env
# NEVER commit .env with real secrets.

# --- Compose / Postgres (used by docker-compose.yml) ---
POSTGRES_USER=ma_minsight
# If the password contains $, escape each $ as $$ in .env (Docker Compose rule).
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ma_minsight
HTTP_PORT=80

# --- ECS-A (HTTPS on host 6443, e.g. https://<公网IP>:6443/) ---
# Uncomment both lines and place certs under deploy/nginx/certs/:
# HTTP_PORT=8080
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.ecs-a.yml

# --- Application (app container; DATABASE_URL/REDIS_URL overridden by compose) ---
API_KEY=CHANGE_ME_API_KEY
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRE_HOURS=8
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

DB_ECHO=false
INGESTION_MAX_BATCHES_PER_RUN=10
EVENT_AGGREGATION_WINDOW_HOURS=24
TRIAGE_DEEP_REVIEW_THRESHOLD=70

# --- LLM (outbound via EgressGateway; BYO base URL is still an egress destination) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Embeddings (optional; privacy.embed_egress_enabled defaults false) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- P0-06 privacy / egress (backend-enforced; see docs/deploy/privacy-config.md) ---
# Priority: PRIVACY_* env > strict_mode clamps > system_config privacy.* > code defaults.
# Do NOT put real secrets in this file. Empty PRIVACY_PSEUDONYM_SECRET + default JWT in
# production => fail-closed (no LLM/WeCom/embed/webhook body egress).
# Pseudonymization is NOT anonymization.
APP_ENV=production
PRIVACY_PSEUDONYM_SECRET=
PRIVACY_STRICT_MODE=false
PRIVACY_LLM_EGRESS_ENABLED=true
PRIVACY_TI_EGRESS_ENABLED=true
PRIVACY_WECOM_EGRESS_ENABLED=true
PRIVACY_EMBED_EGRESS_ENABLED=false
PRIVACY_WEBHOOK_EGRESS_ENABLED=true
# PRIVACY_LLM_ALLOW_PUBLIC_IP_PLAINTEXT=false
# PRIVACY_LLM_ALLOW_USERNAME_PLAINTEXT=false
# PRIVACY_LLM_ALLOW_HOSTNAME_PLAINTEXT=false
# PRIVACY_LLM_ALLOW_FULL_URL=false
# PRIVACY_WECOM_ALLOW_HOST_USER=false
# PRIVACY_ALLOWED_LLM_BASE_URLS=
# PRIVACY_CUSTOMER_SCOPE_ID=

# --- Threat intel sync (optional; cron: deploy/scripts/sync-threat-intel.sh) ---
ABUSEIPDB_API_KEY=
ABUSEIPDB_MAX_AGE_DAYS=90
GREYNOISE_API_KEY=
THREAT_INTEL_SYNC_WINDOW_DAYS=7
THREAT_INTEL_SYNC_LIMIT=200
THREAT_INTEL_CACHE_TTL_HOURS=24
THREAT_INTEL_SKIP_PRIVATE_IPS=true

# --- Wazuh Indexer (referenced by data_sources seed / config) ---
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# --- WeCom human review (phase 6) ---
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_WEBHOOK_URL=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=

# --- Eval alerts (phase 9, optional) ---
# HEALTH_ALERT_WEBHOOK_URL=
